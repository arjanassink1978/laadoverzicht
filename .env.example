# Kopieer naar .env (naast laadoverzicht.py) en vul in. Commit .env nooit.

# --- Zaptec Cloud (https://portal.zaptec.com) ---
# Inloggegevens van je Zaptec-portaalaccount.
ZAPTEC_USERNAME=
ZAPTEC_PASSWORD=
# Optioneel: ID van de Go2-laadpaal. Leeg = alle laadpalen van het account.
ZAPTEC_CHARGER_ID=

# --- Gmail (SMTP smtp.gmail.com:587, STARTTLS) ---
# Je eigen Gmail-adres (afzender).
GMAIL_USER=
# App-wachtwoord (16 tekens), NIET je gewone wachtwoord. Zie README.
GMAIL_APP_PASSWORD=

# --- Ontvangers ---
# Verplicht: e-mailadres van de werkgever.
MAIL_TO=
# Optioneel: naam van de ontvanger voor de aanhef, bijv. "Wim" geeft "Beste Wim,". Leeg = "Beste,".
MAIL_TO_NAME=Wim
# Optioneel: cc-adres. Leeg = gelijk aan GMAIL_USER.
MAIL_CC=

# --- Declaratie ---
# Tarief in EUR per kWh incl. btw, voor alle sessies (geen dal-/nachttarief).
RATE=0.27505
# Naam in onderwerp, bestandsnaam en kop: "declaratie <OWNER_NAME> laadpaal <maand jaar>".
OWNER_NAME=Arjan
# Map voor de xlsx (absoluut pad; op de Pi bij voorkeur de SSD, niet de SD-kaart).
OUTPUT_DIR=/mnt/docker-data/laadoverzicht/output
# Optioneel: logbestand (absoluut pad). Standaard OUTPUT_DIR/laadoverzicht.log.
LOG_FILE=/mnt/docker-data/laadoverzicht/laadoverzicht.log
