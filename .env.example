# Kopieer naar .env (naast laadoverzicht.py) en vul in. Commit .env nooit.

# --- Zaptec Cloud (https://portal.zaptec.com) ---
# Inloggegevens van je Zaptec-portaalaccount.
ZAPTEC_USERNAME=
ZAPTEC_PASSWORD=
# Optioneel: ID van de Go2-laadpaal. Leeg = alle laadpalen van het account.
ZAPTEC_CHARGER_ID=

# --- Gmail (SMTP smtp.gmail.com:587, STARTTLS) ---
# Je eigen Gmail-adres (afzender).
GMAIL_USER=
# App-wachtwoord (16 tekens), NIET je gewone wachtwoord. Zie README.
GMAIL_APP_PASSWORD=

# --- Ontvangers ---
# Verplicht (behalve bij --dry-run): e-mailadres van de ontvanger, bijv. je werkgever.
MAIL_TO=
# Optioneel: naam van de ontvanger voor de aanhef, bijv. "Piet" geeft "Beste Piet,". Leeg = "Beste,".
MAIL_TO_NAME=
# Optioneel: cc-adres. Leeg = gelijk aan GMAIL_USER.
MAIL_CC=

# --- Declaratie ---
# Tarief in EUR per kWh incl. btw, voor alle sessies (geen dal-/nachttarief).
# Eigen keuze: neem het all-in kWh-tarief incl. btw uit je energiecontract. Onderstaande waarde is slechts een voorbeeld.
RATE=0.27505
# Naam in onderwerp, bestandsnaam en kop: "declaratie <OWNER_NAME> laadpaal <maand jaar>". Vul je eigen naam in.
OWNER_NAME=Jan
# Optioneel: map voor de xlsx. Standaard de map "output" naast laadoverzicht.py.
# Gebruik bij voorkeur een absoluut pad (relatieve paden gelden t.o.v. de werkmap van de scheduler).
# OUTPUT_DIR=<pad-naar-laadoverzicht>/output
# Optioneel: logbestand. Standaard OUTPUT_DIR/laadoverzicht.log.
# LOG_FILE=<pad-naar-laadoverzicht>/laadoverzicht.log
